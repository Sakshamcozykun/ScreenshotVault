<!-- src/ScreenshotVault.App/Views/SwipeModeView.xaml -->
<Page
    x:Class="ScreenshotVault.App.Views.SwipeModeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}"
    KeyDown="OnKeyDown">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header / filter -->
            <RowDefinition Height="*"/>      <!-- Card area       -->
            <RowDefinition Height="Auto"/>   <!-- Action bar      -->
            <RowDefinition Height="Auto"/>   <!-- Stats bar       -->
        </Grid.RowDefinitions>

        <!-- ── Header ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Swipe Review"
                           FontFamily="{ThemeResource AppFontFamily}"
                           FontSize="{ThemeResource AppFontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.SessionFilter, Mode=OneWay}"
                           FontFamily="{ThemeResource AppFontFamily}"
                           FontSize="{ThemeResource AppFontSizeBody}"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="↩ Undo (Ctrl+Z)"
                    Style="{ThemeResource AppButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                    Command="{x:Bind ViewModel.UndoLastCommand}"/>
        </Grid>

        <!-- ── Card ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- Completion state -->
            <StackPanel x:Name="CompletionPanel"
                        Visibility="{x:Bind ViewModel.IsComplete, Mode=OneWay,
                                     Converter={StaticResource BoolToVisible}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="✅ All done!"
                           FontFamily="{ThemeResource AppFontFamily}"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource AppSuccessBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.DeletedCount, Mode=OneWay,
                                  Converter={StaticResource IntToDeletedSummary}}"
                           FontFamily="{ThemeResource AppFontFamily}"
                           FontSize="{ThemeResource AppFontSizeBody}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"/>
            </StackPanel>

            <!-- Active card -->
            <Border x:Name="CardBorder"
                    Visibility="{x:Bind ViewModel.IsComplete, Mode=OneWay,
                                 Converter={StaticResource BoolToCollapsed}}"
                    Style="{ThemeResource AppCardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="640"
                    MinHeight="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Screenshot image -->
                    <Image Grid.Row="0"
                           Source="{x:Bind ViewModel.Current.FilePath, Mode=OneWay}"
                           Stretch="Uniform"
                           MaxHeight="420"/>

                    <!-- Metadata strip -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource AppSurfaceBrush}"
                            Padding="12,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Current.Context.WindowTitle, Mode=OneWay}"
                                       FontFamily="{ThemeResource AppFontFamily}"
                                       FontSize="{ThemeResource AppFontSizeBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                            <TextBlock Text="{x:Bind ViewModel.Current.Context.Url, Mode=OneWay}"
                                       FontFamily="{ThemeResource AppFontFamily}"
                                       FontSize="{ThemeResource AppFontSizeCaption}"
                                       Foreground="{ThemeResource AppAccentBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                            <TextBlock FontFamily="{ThemeResource AppFontFamily}"
                                       FontSize="{ThemeResource AppFontSizeCaption}"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}">
                                <Run Text="{x:Bind ViewModel.Current.Category, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{x:Bind ViewModel.Current.CapturedAt, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Swipe direction overlay -->
                    <Border x:Name="DeleteOverlay"
                            Grid.Row="0" Grid.RowSpan="2"
                            Background="#88FF453A"
                            CornerRadius="{ThemeResource AppCornerRadius}"
                            Visibility="{x:Bind ViewModel.LastSwipe, Mode=OneWay,
                                         Converter={StaticResource SwipeLeftToVisible}}">
                        <TextBlock Text="🗑 DELETE"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="KeepOverlay"
                            Grid.Row="0" Grid.RowSpan="2"
                            Background="#8832D74B"
                            CornerRadius="{ThemeResource AppCornerRadius}"
                            Visibility="{x:Bind ViewModel.LastSwipe, Mode=OneWay,
                                         Converter={StaticResource SwipeRightToVisible}}">
                        <TextBlock Text="✅ KEEP"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Action Buttons ────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="32"
                    Margin="0,16">
            <Button Content="← Delete"
                    Style="{ThemeResource AppButtonStyle}"
                    Background="{ThemeResource AppDangerBrush}"
                    Width="140" Height="48"
                    Command="{x:Bind ViewModel.SwipeLeftCommand}"
                    IsEnabled="{x:Bind ViewModel.IsComplete, Mode=OneWay,
                                Converter={StaticResource BoolInvert}}"/>
            <Button Content="Keep →"
                    Style="{ThemeResource AppButtonStyle}"
                    Background="{ThemeResource AppSuccessBrush}"
                    Width="140" Height="48"
                    Command="{x:Bind ViewModel.SwipeRightCommand}"
                    IsEnabled="{x:Bind ViewModel.IsComplete, Mode=OneWay,
                                Converter={StaticResource BoolInvert}}"/>
        </StackPanel>

        <!-- ── Stats Bar ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="24">
            <TextBlock FontFamily="{ThemeResource AppFontFamily}"
                       FontSize="{ThemeResource AppFontSizeCaption}"
                       Foreground="{ThemeResource AppTextSecondaryBrush}">
                <Run Text="Remaining: "/>
                <Run Text="{x:Bind ViewModel.Remaining, Mode=OneWay}"
                     Foreground="{ThemeResource AppTextPrimaryBrush}"/>
            </TextBlock>
            <TextBlock FontFamily="{ThemeResource AppFontFamily}"
                       FontSize="{ThemeResource AppFontSizeCaption}"
                       Foreground="{ThemeResource AppDangerBrush}">
                <Run Text="Deleted: "/>
                <Run Text="{x:Bind ViewModel.DeletedCount, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock FontFamily="{ThemeResource AppFontFamily}"
                       FontSize="{ThemeResource AppFontSizeCaption}"
                       Foreground="{ThemeResource AppSuccessBrush}">
                <Run Text="Kept: "/>
                <Run Text="{x:Bind ViewModel.KeptCount, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

    </Grid>
</Page>
