<!-- src/ScreenshotVault.App/Views/MainShell.xaml -->
<Window
    x:Class="ScreenshotVault.App.Views.MainShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ScreenshotVault.App.Views"
    Title="ScreenshotVault">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Custom title bar / nav -->
            <RowDefinition Height="*"/>      <!-- Page content           -->
            <RowDefinition Height="Auto"/>   <!-- Status bar             -->
        </Grid.RowDefinitions>

        <!-- ── Navigation Bar ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App title -->
                <TextBlock Grid.Column="0"
                           Text="📷 ScreenshotVault"
                           FontFamily="{ThemeResource AppFontFamily}"
                           FontSize="{ThemeResource AppFontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center"/>

                <!-- Nav tabs -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="4">
                    <Button x:Name="BtnGallery"
                            Content="Gallery"
                            Style="{ThemeResource AppButtonStyle}"
                            Click="OnNavGallery"/>
                    <Button x:Name="BtnSwipe"
                            Content="⟵ Swipe Review"
                            Style="{ThemeResource AppButtonStyle}"
                            Click="OnNavSwipe"/>
                    <Button x:Name="BtnMisc"
                            Content="📥 Classify Misc"
                            Style="{ThemeResource AppButtonStyle}"
                            Click="OnNavMisc"/>
                </StackPanel>

                <!-- Theme toggle -->
                <Button Grid.Column="2"
                        x:Name="BtnThemeToggle"
                        Content="🎨 Theme"
                        Style="{ThemeResource AppButtonStyle}"
                        Click="OnToggleTheme"
                        ToolTipService.ToolTip="Toggle Modern / Windows XP theme"/>
            </Grid>
        </Border>

        <!-- ── Page Frame ───────────────────────────────────────────────── -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               Background="{ThemeResource AppBackgroundBrush}"/>

        <!-- ── Status Bar ───────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus"
                           Grid.Column="0"
                           Text="Ready"
                           FontFamily="{ThemeResource AppFontFamily}"
                           FontSize="{ThemeResource AppFontSizeCaption}"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtThemeLabel"
                           Grid.Column="1"
                           Text="{ThemeResource ThemeName}"
                           FontFamily="{ThemeResource AppFontFamily}"
                           FontSize="{ThemeResource AppFontSizeCaption}"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Toast notification overlay ─────────────────────────────── -->
        <Border x:Name="ToastBanner"
                Grid.Row="0" Grid.RowSpan="3"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,16,60"
                Background="{ThemeResource AppSurfaceRaisedBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource AppCornerRadius}"
                Padding="16,10"
                Visibility="Collapsed"
                MaxWidth="320">
            <StackPanel Spacing="2">
                <TextBlock x:Name="ToastTitle"
                           FontFamily="{ThemeResource AppFontFamily}"
                           FontSize="{ThemeResource AppFontSizeBody}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                <TextBlock x:Name="ToastSubtitle"
                           FontFamily="{ThemeResource AppFontFamily}"
                           FontSize="{ThemeResource AppFontSizeCaption}"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
