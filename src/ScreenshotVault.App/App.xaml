<!-- src/ScreenshotVault.App/App.xaml -->
<Application
    x:Class="ScreenshotVault.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ScreenshotVault.App.Converters">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!-- Active theme — swapped at runtime by ThemeService -->
                <ResourceDictionary Source="ms-appx:///Assets/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ── Converters (global, referenced in all views) ──────────── -->
            <conv:BoolToVisibilityConverter     x:Key="BoolToVisible"/>
            <conv:BoolToCollapsedConverter      x:Key="BoolToCollapsed"/>
            <conv:BoolInvertConverter           x:Key="BoolInvert"/>
            <conv:SwipeLeftToVisibilityConverter  x:Key="SwipeLeftToVisible"/>
            <conv:SwipeRightToVisibilityConverter x:Key="SwipeRightToVisible"/>
            <conv:IntToDeletedSummaryConverter  x:Key="IntToDeletedSummary"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
