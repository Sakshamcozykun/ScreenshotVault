<!-- src/ScreenshotVault.App/Assets/Themes/Modern.xaml -->
<!-- Fluent/Mica-inspired tokens. All keys must mirror XPPixelArt.xaml exactly. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Core Palette ──────────────────────────────────────────────────── -->
    <Color x:Key="AppBackground">#FF1C1C1E</Color>
    <Color x:Key="AppSurface">#FF2C2C2E</Color>
    <Color x:Key="AppSurfaceRaised">#FF3A3A3C</Color>
    <Color x:Key="AppAccent">#FF0A84FF</Color>
    <Color x:Key="AppAccentHover">#FF409CFF</Color>
    <Color x:Key="AppTextPrimary">#FFFFFFFF</Color>
    <Color x:Key="AppTextSecondary">#FF8E8E93</Color>
    <Color x:Key="AppBorder">#FF48484A</Color>
    <Color x:Key="AppDanger">#FFFF453A</Color>
    <Color x:Key="AppSuccess">#FF32D74B</Color>

    <!-- ── Brushes ────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AppBackgroundBrush"    Color="{StaticResource AppBackground}"/>
    <SolidColorBrush x:Key="AppSurfaceBrush"       Color="{StaticResource AppSurface}"/>
    <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="{StaticResource AppSurfaceRaised}"/>
    <SolidColorBrush x:Key="AppAccentBrush"        Color="{StaticResource AppAccent}"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush"   Color="{StaticResource AppTextPrimary}"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondary}"/>
    <SolidColorBrush x:Key="AppBorderBrush"        Color="{StaticResource AppBorder}"/>
    <SolidColorBrush x:Key="AppDangerBrush"        Color="{StaticResource AppDanger}"/>
    <SolidColorBrush x:Key="AppSuccessBrush"       Color="{StaticResource AppSuccess}"/>

    <!-- ── Typography ────────────────────────────────────────────────────── -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable</FontFamily>
    <x:Double   x:Key="AppFontSizeBody">14</x:Double>
    <x:Double   x:Key="AppFontSizeCaption">12</x:Double>
    <x:Double   x:Key="AppFontSizeTitle">20</x:Double>

    <!-- ── Shape / Spacing ───────────────────────────────────────────────── -->
    <CornerRadius x:Key="AppCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusSmall">4</CornerRadius>
    <x:Double    x:Key="AppBorderThickness">1</x:Double>

    <!-- ── Button Style (Modern) ─────────────────────────────────────────── -->
    <Style x:Key="AppButtonStyle" TargetType="Button">
        <Setter Property="Background"   Value="{StaticResource AppAccentBrush}"/>
        <Setter Property="Foreground"   Value="{StaticResource AppTextPrimaryBrush}"/>
        <Setter Property="FontFamily"   Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize"     Value="{StaticResource AppFontSizeBody}"/>
        <Setter Property="Padding"      Value="16,8"/>
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ── Card Style ────────────────────────────────────────────────────── -->
    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource AppBorderBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CornerRadius"     Value="{StaticResource AppCornerRadius}"/>
        <Setter Property="Padding"          Value="16"/>
    </Style>

    <!-- Theme name token — used by UI to show current theme label -->
    <x:String x:Key="ThemeName">Modern</x:String>
    <x:Boolean x:Key="IsXPTheme">False</x:Boolean>

</ResourceDictionary>
