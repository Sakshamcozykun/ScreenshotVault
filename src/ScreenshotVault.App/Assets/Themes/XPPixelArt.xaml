<!-- src/ScreenshotVault.App/Assets/Themes/XPPixelArt.xaml -->
<!-- Windows XP Luna aesthetic. All keys mirror Modern.xaml exactly. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Core Palette (XP Luna) ───────────────────────────────────────── -->
    <Color x:Key="AppBackground">#FFD4D0C8</Color>      <!-- XP desktop grey  -->
    <Color x:Key="AppSurface">#FFECE9D8</Color>          <!-- Window fill      -->
    <Color x:Key="AppSurfaceRaised">#FFF5F4EE</Color>   <!-- Raised panel     -->
    <Color x:Key="AppAccent">#FF0A246A</Color>           <!-- Title bar blue   -->
    <Color x:Key="AppAccentHover">#FF1B4B9F</Color>
    <Color x:Key="AppTextPrimary">#FF000000</Color>
    <Color x:Key="AppTextSecondary">#FF444444</Color>
    <Color x:Key="AppBorder">#FF808080</Color>
    <Color x:Key="AppDanger">#FFCC0000</Color>
    <Color x:Key="AppSuccess">#FF007700</Color>

    <!-- ── Brushes ────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AppBackgroundBrush"    Color="{StaticResource AppBackground}"/>
    <SolidColorBrush x:Key="AppSurfaceBrush"       Color="{StaticResource AppSurface}"/>
    <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="{StaticResource AppSurfaceRaised}"/>
    <SolidColorBrush x:Key="AppAccentBrush"        Color="{StaticResource AppAccent}"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush"   Color="{StaticResource AppTextPrimary}"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondary}"/>
    <SolidColorBrush x:Key="AppBorderBrush"        Color="{StaticResource AppBorder}"/>
    <SolidColorBrush x:Key="AppDangerBrush"        Color="{StaticResource AppDanger}"/>
    <SolidColorBrush x:Key="AppSuccessBrush"       Color="{StaticResource AppSuccess}"/>

    <!-- XP 3-D raised border brushes (used in button template) -->
    <SolidColorBrush x:Key="XPHighlightBrush"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="XPShadowBrush"       Color="#FF808080"/>
    <SolidColorBrush x:Key="XPDarkShadowBrush"   Color="#FF404040"/>

    <!-- Title bar gradient -->
    <LinearGradientBrush x:Key="XPTitleBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0A246A" Offset="0.0"/>
        <GradientStop Color="#FFA6CAF0" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ── Typography ────────────────────────────────────────────────────── -->
    <!-- W95FA is a free pixel font; ship it under Assets/Fonts/           -->
    <!-- Fallback: Tahoma (native XP font, ships with Windows)             -->
    <FontFamily x:Key="AppFontFamily">Tahoma, Segoe UI</FontFamily>
    <x:Double   x:Key="AppFontSizeBody">11</x:Double>
    <x:Double   x:Key="AppFontSizeCaption">10</x:Double>
    <x:Double   x:Key="AppFontSizeTitle">13</x:Double>

    <!-- ── Shape / Spacing ───────────────────────────────────────────────── -->
    <CornerRadius x:Key="AppCornerRadius">0</CornerRadius>   <!-- XP = sharp corners -->
    <CornerRadius x:Key="AppCornerRadiusSmall">0</CornerRadius>
    <x:Double    x:Key="AppBorderThickness">2</x:Double>

    <!-- ── Button Style (XP 3-D raised) ─────────────────────────────────── -->
    <Style x:Key="AppButtonStyle" TargetType="Button">
        <Setter Property="FontFamily"      Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="{StaticResource AppFontSizeBody}"/>
        <Setter Property="Foreground"      Value="{StaticResource AppTextPrimaryBrush}"/>
        <Setter Property="Padding"         Value="10,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Outer dark shadow border -->
                    <Border BorderThickness="1"
                            BorderBrush="{StaticResource XPDarkShadowBrush}">
                        <!-- Outer highlight border (top-left bright) -->
                        <Border BorderThickness="1,1,0,0"
                                BorderBrush="{StaticResource XPHighlightBrush}">
                            <!-- Inner shadow border (bottom-right) -->
                            <Border BorderThickness="0,0,1,1"
                                    BorderBrush="{StaticResource XPShadowBrush}"
                                    Background="{StaticResource AppSurfaceBrush}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Card Style (XP inset panel) ──────────────────────────────────── -->
    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource AppSurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <!-- Inset look: dark top-left, light bottom-right -->
        <Setter Property="BorderBrush"     Value="{StaticResource XPShadowBrush}"/>
        <Setter Property="CornerRadius"    Value="{StaticResource AppCornerRadius}"/>
        <Setter Property="Padding"         Value="12"/>
    </Style>

    <!-- ── XP Title Bar Style ─────────────────────────────────────────────── -->
    <Style x:Key="XPTitleBarStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource XPTitleBarBrush}"/>
        <Setter Property="Padding"         Value="8,4"/>
        <Setter Property="Height"          Value="26"/>
    </Style>

    <!-- Theme name token -->
    <x:String  x:Key="ThemeName">Windows XP</x:String>
    <x:Boolean x:Key="IsXPTheme">True</x:Boolean>

</ResourceDictionary>
